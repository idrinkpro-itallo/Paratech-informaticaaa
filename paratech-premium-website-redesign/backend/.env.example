# Porta do servidor HTTP
PORT=3333

# Banco SQLite (arquivo local). Para migrar a Postgres depois, troque a URL.
DATABASE_URL="file:./prisma/dev.db"

# Origem(ns) permitida(s) no CORS. Use "*" em dev, ou a URL do site em produção.
CORS_ORIGIN="*"

# Token opcional para proteger as rotas de escrita (POST/PUT/DELETE/upload).
# Se deixar VAZIO, as rotas de escrita ficam abertas (sem autenticação).
# Se definir, o cliente precisa enviar o header:  x-admin-token: <valor>
ADMIN_TOKEN=

# Base pública do backend, usada para montar URLs de imagens enviadas.
PUBLIC_BASE_URL="http://localhost:3333"
