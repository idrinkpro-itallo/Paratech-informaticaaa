// Schema do site da Paratech.
// Espelha 1:1 a fonte de verdade dos protótipos: project/products-data.js
// (PRODUCTS, CATEGORY_META, STOCK_META). O seed em prisma/seed.js popula a
// base a partir de lib/products-data.js, garantindo paridade com o design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Categoria de produto — carrega a identidade visual (gradiente c1→c2, accent,
// glow) usada nos cards e tiles. O `id` é o slug (ex.: "laptops"), travado
// após a criação (é FK de Product e vira hash da URL do Catálogo).
// Gerenciada pelo admin (/admin/categorias). As 14 categorias originais têm
// um ícone SVG desenhado à mão em components/icons/CategoryIcon.js indexado
// pelo `id`; categorias novas usam um dos ícones genéricos de `iconKey`.
model Category {
  id         String    @id
  label      String
  tagline    String    @default("")
  iconKey    String    @default("generic-box")
  c1         String
  c2         String
  accent     String
  glow       String
  visible    Boolean   @default(true)
  coverImage String?
  products   Product[]
}

// Conteúdo editável da Home e do Contato (hero, promoção, depoimentos,
// galeria, infos de contato etc.) — uma linha JSON por seção em vez de uma
// tabela rígida por seção, já que cada seção tem forma bem diferente (listas
// de tiles, depoimentos, features). Gerenciado pelo admin (/admin/home,
// /admin/contato); os defaults ficam em lib/site-content.js e são usados
// caso a linha ainda não exista (banco novo, antes do seed rodar).
model SiteContent {
  section   String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// Estados de estoque com rótulo e cor (in-stock / low-stock / backorder).
// Fixos — não editáveis pelo admin.
model StockStatus {
  key      String    @id
  label    String
  color    String
  products Product[]
}

// Produto do catálogo. `oldPrice` e `tag` são opcionais; `brand` default
// "Genérico"; `imageUrl` guarda a foto real enviada via upload no admin
// (Vercel Blob) — quando ausente, o card usa o visual .pv-visual (gradiente).
model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  price       Float
  oldPrice    Float?
  installment String
  tag         String?
  brand       String      @default("Genérico")
  imageUrl    String?
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  stockStatus StockStatus @relation(fields: [stock], references: [key])
  stock       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([stock])
}

// Lead capturado pelo formulário de contato ou por um pedido de orçamento.
// Modelo mantido para uso futuro — hoje nada grava aqui (o formulário de
// Contato continua abrindo o WhatsApp direto, sem persistir).
model Lead {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String
  assunto   String?
  mensagem  String?
  source    String   @default("contato")
  productId Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
