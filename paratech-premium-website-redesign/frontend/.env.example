# Postgres (provisionado via `vercel install neon` — ver COMO-FINALIZAR-RAPIDO.md).
# Depois de rodar `vercel env pull`, confirme o nome exato da variável que a
# integração Neon gerou (pode não ser literalmente DATABASE_URL) e ajuste aqui
# e em prisma/schema.prisma se for diferente.
DATABASE_URL=""

# Vercel Blob — token gerado ao criar o store (`vercel blob create-store`) e
# conectado automaticamente ao projeto.
BLOB_READ_WRITE_TOKEN=""

# Senha única do painel /admin.
ADMIN_PASSWORD=""

# Chave usada para assinar o cookie de sessão do admin. Gere com:
#   openssl rand -base64 32
SESSION_SECRET=""
